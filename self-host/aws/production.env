# Plain settings for the production web, worker and migrate tasks, read by
# .github/workflows/deploy.yml. This repository is public: never put a secret
# here. Secrets come from SSM Parameter Store, named in production.secrets.
#
# One KEY=value per line, comments on their own lines. The deploy stops while a
# value still holds a <placeholder>.

NODE_ENV=production
SELF_HOSTED=true
LOG_LEVEL=info
PORT=4002

# Exactly the address people open: GitHub sign-in is checked against it.
SERVER_URL=https://app.argos.wakecap.com
API_BASE_URL=https://api.argos.wakecap.com
MCP_BASE_URL=https://mcp.argos.wakecap.com
# The parent of the app. and api. hosts: GitHub sign-in sets the session cookie
# through the API host.
SESSION_DOMAIN=argos.wakecap.com
WEBAUTHN_RP_ID=app.argos.wakecap.com
WEBAUTHN_ORIGINS=https://app.argos.wakecap.com
# TLS ends at the load balancer, which sends X-Forwarded-Proto.
SERVER_SECURE=true
SERVER_HTTPS_REDIRECT=true

AWS_SCREENSHOTS_BUCKET=<screenshots bucket>
S3_REGION=<bucket region>
# Empty on purpose: it overrides upstream's image CDN, so browsers get signed
# links to the bucket instead.
S3_PUBLIC_IMAGE_BASE_URL=
# Empty: the app serves its own frontend files.
ASSETS_BASE_URL=

GITHUB_APP_URL=https://github.com/apps/<production app slug>
CONTACT_EMAIL=<who people should contact about Argos>
TRACK_NPM_PACKAGE_VERSIONS=false
