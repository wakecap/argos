    {
      "name": "argos-migrate",
      "image": "",
      "command": ["scripts/release.sh"],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/argos-migrate",
          "awslogs-create-group": "true",
          "awslogs-region": "",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [],
      "secrets": []
    }
  ]
}
