# Settings for the web and worker processes of a self-hosted Argos.
# Copy to `.env` (git-ignored) and fill in the secrets. Values here are for the
# local stack in docker-compose.yml; see README.md for the AWS equivalents.

NODE_ENV=production
LOG_LEVEL=info

# Where people open Argos, and where CI uploads to. The app and the API are the
# same process, told apart by the `app.` / `api.` subdomain.
PORT=4002
SERVER_URL=http://app.localhost:4002
API_BASE_URL=http://api.localhost:4002
MCP_BASE_URL=http://mcp.localhost:4002
# Empty: the session cookie stays on the app host.
SESSION_DOMAIN=
WEBAUTHN_RP_ID=app.localhost
WEBAUTHN_ORIGINS=http://app.localhost:4002
# Plain http locally. Behind a TLS-terminating load balancer, set both to true.
SERVER_SECURE=false
SERVER_HTTPS_REDIRECT=false
# Empty: the frontend assets are served by the app itself, not a CDN.
ASSETS_BASE_URL=

# Secrets: generate your own (`openssl rand -hex 32`). Never reuse these.
SERVER_SESSION_SECRET=
ENCRYPTION_KEY=

# Postgres, Redis, RabbitMQ
DATABASE_URL=postgres://postgres@postgres:5432/argos
REDIS_URL=redis://redis:6379
AMQP_URL=amqp://rabbitmq:5672

# Screenshot storage. Locally MinIO; on AWS drop S3_ENDPOINT and
# S3_FORCE_PATH_STYLE and give the task role access to the bucket instead of keys.
AWS_SCREENSHOTS_BUCKET=argos-screenshots
S3_REGION=us-east-1
S3_ENDPOINT=http://host.docker.internal:9100
S3_FORCE_PATH_STYLE=true
# Empty: the browser gets short-lived signed URLs instead of an image CDN.
S3_PUBLIC_IMAGE_BASE_URL=
AWS_ACCESS_KEY_ID=argos
AWS_SECRET_ACCESS_KEY=argos-local-only
